# =====================================================================
#  Reto 50 Onix · Credenciales y configuracion de entorno
#
#  Este archivo NO se versiona (esta en .gitignore). Para compartir la
#  forma del archivo con el equipo se usa .env.ejemplo.
#
#  Aviso importante: en una app web todo lo que esta aqui viaja al
#  navegador. Por eso solo puede contener la ANON KEY, que es publica
#  por diseno y esta limitada por las politicas RLS de la base de datos.
#  La service_role key JAMAS debe escribirse aqui.
# =====================================================================

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# Origen de los datos:
#   supabase -> lee y escribe en el proyecto Supabase de arriba.
#   memoria  -> demostracion local, sin backend (util sin conexion).
ORIGEN_DATOS=supabase

# La verificacion del telefono al registrarse la hace Twilio Verify desde
# la Edge Function `verificar-telefono`. Sus credenciales NO van aqui (este
# archivo llega al navegador): van como secretos de Supabase, ver
# supabase/.env.ejemplo. Para iniciar sesion se usa usuario y contrasena.
