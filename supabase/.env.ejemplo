# =====================================================================
#  Reto 50 Onix · Secretos de la Edge Function `verificar-telefono`
#
#  Copia este archivo a supabase/.env (NO se versiona), completa los
#  valores y subelos a Supabase con:
#
#    npx supabase secrets set --env-file supabase/.env --project-ref dznogtqwxhiiytqifeqt
#
#  o pegalos a mano en el panel: Edge Functions -> Secrets.
#
#  IMPORTANTE: debe ser una cuenta de Twilio PROPIA de la landing. No se
#  puede usar la cuenta de Twilio de Onix Drive ni una subcuenta suya.
#
#  Estos valores JAMAS van en el .env de la raiz: ese archivo viaja al
#  navegador y cualquiera podria mandar SMS a nuestro costo.
# =====================================================================

# Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token

# Twilio Console -> Verify -> Services -> (crear servicio) -> Service SID
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional. Canal del codigo: sms (por defecto) o whatsapp. WhatsApp exige
# configurar antes un remitente de WhatsApp en el servicio de Verify.
TWILIO_CANAL=sms

# Opcional. true = antes de enviar el SMS se consulta Twilio Lookup y se
# rechazan numeros VoIP y fijos. Cada consulta tiene costo.
TWILIO_VALIDAR_TIPO_LINEA=false
